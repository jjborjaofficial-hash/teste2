# URL base da API do backend (ver aprenda-e-ganhe/backend)
VITE_API_URL=http://localhost:3000/api/v1

# ============================
# NOTIFICAÇÕES PUSH (Firebase Cloud Messaging — Web)
# ============================
# Preencha para ativar push no navegador (ver src/lib/pushNotifications.js).
# Mesmo projeto Firebase do backend (FIREBASE_PROJECT_ID no backend/.env),
# mas estes são os valores do "app da Web" (console.firebase.google.com →
# Configurações do Projeto → Geral → Seus apps → Web).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Console Firebase → Configurações do Projeto → Cloud Messaging → Certificados push da Web
VITE_FIREBASE_VAPID_KEY=

# ============================
# ANÚNCIOS (Adcash — modo "manage ad formats manually")
# ============================
# Interruptor geral. Com isto em "false" (ou vazio), NENHUM anúncio
# aparece em lado nenhum, mesmo que os formatos abaixo estejam "true".
VITE_ADS_ENABLED=false

# Ativar/desativar cada formato individualmente (ver src/ads/adConfig.js).
VITE_ADS_DISPLAY_ENABLED=true
VITE_ADS_INTERSTITIAL_ENABLED=true
VITE_ADS_VIDEO_ENABLED=false
VITE_ADS_POPUNDER_ENABLED=false
VITE_ADS_INPAGEPUSH_ENABLED=false

# Zone ID de cada localização (painel do Adcash → Sites → Ad Zones →
# criar zona → copiar o Zone ID, não o código completo). Localização
# sem Zone ID preenchido não mostra anúncio, mesmo com o formato ativo.
VITE_ADCASH_ZONE_DASHBOARD=      # Display 300x100
VITE_ADCASH_ZONE_CONTENT=        # Display 250x250 — Hub de Estudos
VITE_ADCASH_ZONE_QUIZRESULT=     # Interstitial (tela cheia, sem dimensão fixa)
VITE_ADCASH_ZONE_WALLET=         # Display 300x100 — zona ainda não criada
VITE_ADCASH_ZONE_VIDEO=
VITE_ADCASH_ZONE_POPUNDER=
VITE_ADCASH_ZONE_INPAGEPUSH=
