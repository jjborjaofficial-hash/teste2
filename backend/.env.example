# ============================
# AMBIENTE
# ============================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ============================
# BANCO DE DADOS (PostgreSQL)
# ============================
# Em produção, aponte para o usuário "database_api" (privilégio mínimo — sem
# CREATE/ALTER/DROP), NUNCA para o superusuário/admin do banco. Rode
# backend/database/security/create_db_roles.sql uma vez, com o usuário
# administrador, para provisionar database_api e database_readonly.
# Rotação de credenciais e checklist completo: docs/seguranca-credenciais-banco-de-dados.md
DATABASE_URL=postgres://usuario:senha@localhost:5432/aprenda_e_ganhe
DATABASE_SSL=false

# ============================
# CACHE (Redis)
# ============================
REDIS_URL=redis://localhost:6379

# ============================
# AUTENTICAÇÃO / JWT
# Gere segredos fortes com: openssl rand -base64 64
# ============================
JWT_ACCESS_SECRET=troque_este_valor_em_producao
JWT_REFRESH_SECRET=troque_este_valor_em_producao_tambem
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ============================
# SEGURANÇA
# ============================
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# ============================
# LOCALIZAÇÃO (conforme Doc. Mestre Seção 3)
# ============================
DEFAULT_COUNTRY=MZ
DEFAULT_CURRENCY=MZN
DEFAULT_LOCALE=pt-MZ
