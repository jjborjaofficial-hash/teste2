# ============================
# AMBIENTE
# ============================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ============================
# BANCO DE DADOS (PostgreSQL)
# ============================
# Em produção, aponte para o usuário "database_api" (privilégio mínimo — sem
# CREATE/ALTER/DROP), NUNCA para o superusuário/admin do banco. Rode
# backend/database/security/create_db_roles.sql uma vez, com o usuário
# administrador, para provisionar database_api e database_readonly.
# Rotação de credenciais e checklist completo: docs/seguranca-credenciais-banco-de-dados.md
DATABASE_URL=postgres://usuario:senha@localhost:5432/aprenda_e_ganhe
DATABASE_SSL=false

# ============================
# CACHE (Redis)
# ============================
REDIS_URL=redis://localhost:6379

# ============================
# AUTENTICAÇÃO / JWT
# Gere segredos fortes com: openssl rand -base64 64
# ============================
JWT_ACCESS_SECRET=troque_este_valor_em_producao
JWT_REFRESH_SECRET=troque_este_valor_em_producao_tambem
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ============================
# SEGURANÇA
# ============================
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Domínio(s) autorizados a chamar esta API pelo navegador (CORS), separados
# por vírgula, SEMPRE com o esquema (https://) — nunca "*" em produção.
# Ex.: https://app.seudominio.com,https://admin.seudominio.com
# Sem isso definido, só http://localhost:5173 é aceito — o frontend
# publicado seria bloqueado por CORS ao chamar a API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ============================
# LOCALIZAÇÃO (conforme Doc. Mestre Seção 3)
# ============================
DEFAULT_COUNTRY=MZ
DEFAULT_CURRENCY=MZN
DEFAULT_LOCALE=pt-MZ

# ============================
# NOTIFICAÇÕES PUSH (Firebase Cloud Messaging)
# ============================
# Preencha as 3 variáveis abaixo para ativar push de verdade. Até lá, o
# backend funciona normalmente — push fica só em modo silencioso (ver
# src/common/notifications/pushService.js e docs/notificacoes-push-sms.md).
# Como obter: console.firebase.google.com → Configurações do Projeto →
# Contas de Serviço → "Gerar nova chave privada" (baixa um .json com estes 3 campos).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Cole a chave inteira numa linha só, com \n literal no lugar das quebras de linha.
FIREBASE_PRIVATE_KEY=

# ============================
# SMS (Twilio)
# ============================
# Preencha para ativar SMS de verdade (hoje só é usado na confirmação de
# saque pago — ver notificationsService.notifyWithdrawalStatus). Até lá, modo
# silencioso (src/common/notifications/smsService.js).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
