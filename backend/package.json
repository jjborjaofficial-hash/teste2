{
  "name": "aprenda-e-ganhe-backend",
  "version": "0.1.0",
  "description": "Backend oficial da plataforma Aprenda e Ganhe (Node.js + Express + PostgreSQL)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "worker": "node src/queue/worker.js",
    "worker:dev": "nodemon src/queue/worker.js",
    "migrate": "node src/database/migrate.js up",
    "migrate:up": "node src/database/migrate.js up",
    "migrate:down": "node src/database/migrate.js down",
    "test": "jest --runInBand",
    "lint": "eslint src",
    "quiz:validate": "node scripts/quizValidate.js",
    "quiz:audit": "node scripts/quizAudit.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bullmq": "^5.12.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "cron-parser": "^4.9.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^12.6.0",
    "google-auth-library": "^9.14.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "rate-limit-redis": "^4.2.0",
    "twilio": "^5.3.0",
    "uuid": "^9.0.1",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
